/**
 * Resolves Mustache names across the context stack without invoking arbitrary methods.
 */
class {
	public struct function lookup(
		required string name,
		required array contextStack,
		array nameParts = []
	) {
		var stack = arguments.contextStack;
		var stackCount = arrayLen( stack );

		if ( arguments.name == "." ) {
			return {
				found: stackCount > 0,
				value: stackCount > 0 ? stack[ stackCount ] : ""
			};
		}

		var parts = arguments.nameParts;
		if ( arrayLen( parts ) == 0 ) {
			parts = buildNameParts( arguments.name );
		}

		if ( arrayLen( parts ) == 1 ) {
			for ( var i = stackCount; i >= 1; i-- ) {
				var resolved = resolvePath( stack[ i ], parts );
				if ( resolved.found ) {
					return resolved;
				}
			}

			return { found: false, value: "" };
		}

		for ( var i = stackCount; i >= 1; i-- ) {
			var resolved = resolvePath( stack[ i ], parts, 1, 1 );
			if ( resolved.found ) {
				if ( isNull( resolved.value ) ) {
					return { found: false, value: "" };
				}

				return resolvePath( resolved.value, parts, 2 );
			}
		}

		return { found: false, value: "" };
	}

	private array function buildNameParts( required string name ) {
		if ( arguments.name == "." ) {
			return [ "." ];
		}

		if ( find( ".", arguments.name ) == 0 ) {
			return [ arguments.name ];
		}

		return listToArray( arguments.name, "." );
	}

	private struct function resolvePath(
		required any context,
		required array parts,
		numeric startIndex = 1,
		numeric endIndex = arrayLen( arguments.parts )
	) {
		var current = arguments.context;

		for ( var i = arguments.startIndex; i <= arguments.endIndex; i++ ) {
			var key = arguments.parts[ i ];
			if ( isNull( current ) ) {
				return { found: false, value: "" };
			}

			if ( isStruct( current ) && structKeyExists( current, key ) ) {
				current = current[ key ];
				continue;
			}

			if ( isArray( current ) && isNumeric( key ) ) {
				var index = val( key );
				if ( index >= 1 && index <= arrayLen( current ) ) {
					current = current[ index ];
					continue;
				}
			}

			var dynamicStep = resolveDynamicPathStep( current, key );
			if ( dynamicStep.found ) {
				current = dynamicStep.value;
				continue;
			}

			return { found: false, value: "" };
		}

		return { found: true, value: current };
	}

	private struct function resolveDynamicPathStep( required any current, required string key ) {
		var defaultResult = { found: false, value: "" };

		if ( isArray( arguments.current ) || ( isStruct( arguments.current ) && !isObject( arguments.current ) ) ) {
			return defaultResult;
		}
		if ( isSimpleValue( arguments.current ) ) {
			// BoxLang scalar wrappers (String, Number, Boolean, Character) are not
			// context objects. Date-like Java values still support bean getters.
			try {
				var scalarClassName = arguments.current.$bx.$class.getName();
				if ( findNoCase( "java.lang.", scalarClassName ) == 1 ) {
					return defaultResult;
				}
			} catch ( any e ) {
				return defaultResult;
			}
		}

		if (
			( isStruct( arguments.current ) || isObject( arguments.current ) ) &&
			structKeyExists( arguments.current, arguments.key )
		) {
			return { found: true, value: arguments.current[ arguments.key ] };
		}

		return resolveObjectAccessor( arguments.current, arguments.key );
	}

	private struct function resolveObjectAccessor( required any current, required string key ) {
		var defaultResult = { found: false, value: "" };
		var accessorMethodNames = buildAccessorMethodNames( arguments.key );
		// Public member lookup includes generated and inherited BoxLang accessors.
		// Never reflect on their implementation class: its getters expose runtime scopes.
		if ( isInstanceOf( arguments.current, "ortus.boxlang.runtime.runnables.IClassRunnable" ) ) {
			for ( var methodName in accessorMethodNames ) {
				if ( structKeyExists( arguments.current, methodName ) ) {
					var accessor = arguments.current[ methodName ];
					if ( isCustomFunction( accessor ) && arrayLen( getMetadata( accessor ).parameters ) == 0 ) {
						return { found: true, value: invoke( arguments.current, methodName, {} ) };
					}
				}
			}
			return defaultResult;
		}

		// Java values expose their class through BoxLang's native metadata scope.
		var javaClass = "";
		try {
			javaClass = arguments.current.$bx.$class;
		} catch ( any e ) {
			// Values without BoxLang/Java member metadata simply have no dynamic path step.
			return defaultResult;
		}

		for ( var methodName in accessorMethodNames ) {
			var methodResult = findJavaZeroArgMethod( javaClass, methodName );
			if ( methodResult.found ) {
				return {
					found: true,
					value: methodResult.method.invoke( arguments.current, [] )
				};
			}
		}

		try {
			var field = javaClass.getField( arguments.key );
			return {
				found: true,
				value: field.get( arguments.current )
			};
		} catch ( any e ) {
			if ( findNoCase( "NoSuchFieldException", e.type & "" ) > 0 ) {
				return defaultResult;
			}
			throw( type = e.type, message = e.message, detail = structKeyExists( e, "detail" ) ? e.detail : "" );
		}
	}

	private struct function findJavaZeroArgMethod( required any javaClass, required string methodName ) {
		if ( !len( arguments.methodName ) ) {
			return { found: false };
		}

		try {
			var method = arguments.javaClass.getMethod( arguments.methodName );
			return method.getParameterCount() == 0
				? { found: true, method: method }
				: { found: false };
		} catch ( any e ) {
			if ( findNoCase( "NoSuchMethodException", e.type & "" ) > 0 ) {
				return { found: false };
			}

			throw( type = e.type, message = e.message, detail = structKeyExists( e, "detail" ) ? e.detail : "" );
		}
	}

	private array function buildAccessorMethodNames( required string key ) {
		var normalizedKey = trim( arguments.key );
		if ( !len( normalizedKey ) ) {
			return [ "", "" ];
		}

		var accessorSuffix = uCase( left( normalizedKey, 1 ) ) & mid( normalizedKey, 2, len( normalizedKey ) - 1 );
		return [ "get" & accessorSuffix, "is" & accessorSuffix ];
	}
}
