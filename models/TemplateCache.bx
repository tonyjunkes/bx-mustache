/**
 * Thread-safe, in-memory LRU cache for parsed template ASTs.
 *
 * A ordered, case-sensitive struct stores both entries and recency.
 * BoxLang locks protect reads and writes; deleting and reinserting a hit moves
 * it to the tail without scanning a separate order list. The cache remains
 * instance-local so isolated renderers do not share lifecycle or eviction state.
 */
class implements="ITemplateCache" {
	variables._entries = structNew( "ordered-casesensitive" );
	variables._cacheMaxEntries = 200;
	variables._cacheEnabled = true;
	variables._cacheGeneration = 0;
	variables._cacheLockName = "Mustache.TemplateCache." & replace( createUUID(), "-", "", "all" );

	public void function configure(
		boolean enabled = true,
		numeric maxEntries = 200
	) {
		bx:lock name=variables._cacheLockName type="exclusive" timeout="5" {
			variables._cacheEnabled = arguments.enabled;
			variables._cacheMaxEntries = max( 1, int( arguments.maxEntries ) );
			variables._cacheGeneration++;

			if ( !variables._cacheEnabled ) {
				_resetState();
			} else {
				_evictIfNeeded();
			}
		}
	}

	public void function clear() {
		bx:lock name=variables._cacheLockName type="exclusive" timeout="5" {
			variables._cacheGeneration++;
			_resetState();
		}
	}

	public struct function getStats() {
		var stats = {};
		bx:lock name=variables._cacheLockName type="readonly" timeout="5" {
			stats = {
				enabled: variables._cacheEnabled,
				maxEntries: variables._cacheMaxEntries,
				currentEntries: structCount( variables._entries )
			};
		}
		return stats;
	}

	public array function getOrSet(
		required string template,
		required string openDelimiter,
		required string closeDelimiter,
		required function parseFn
	) {
		var cacheKey = _buildKey( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
		var cachedAst = [];
		var hasCached = false;
		var cacheEnabled = false;

		// A hit is moved to the tail, so this must be exclusive.
		bx:lock name=variables._cacheLockName type="exclusive" timeout="5" {
			cacheEnabled = variables._cacheEnabled;
			if ( cacheEnabled && structKeyExists( variables._entries, cacheKey ) ) {
				hasCached = true;
				cachedAst = variables._entries[ cacheKey ];
				_touchKey( cacheKey, cachedAst );
			}
		}

		if ( !cacheEnabled ) {
			return arguments.parseFn( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
		}

		if ( hasCached ) {
			return cachedAst;
		}

		// Coalesce only identical misses. Different templates retain parallelism.
		var keyLockName = variables._cacheLockName & ".key." & cacheKey.hashCode();
		var result = [];
		var hasResult = false;

		bx:lock name=keyLockName type="exclusive" timeout="5" {
			var currentGeneration = 0;
			var currentEnabled = false;

			bx:lock name=variables._cacheLockName type="exclusive" timeout="5" {
				currentEnabled = variables._cacheEnabled;
				currentGeneration = variables._cacheGeneration;
				if ( currentEnabled && structKeyExists( variables._entries, cacheKey ) ) {
					result = variables._entries[ cacheKey ];
					_touchKey( cacheKey, result );
					hasResult = true;
				}
			}

			if ( !hasResult ) {
				if ( !currentEnabled ) {
					result = arguments.parseFn( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
					hasResult = true;
				} else {
					var ast = arguments.parseFn( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
					result = ast;
					hasResult = true;

					bx:lock name=variables._cacheLockName type="exclusive" timeout="5" {
						if (
							variables._cacheEnabled &&
							variables._cacheGeneration == currentGeneration
						) {
							if ( !structKeyExists( variables._entries, cacheKey ) ) {
								variables._entries[ cacheKey ] = ast;
							}
							_evictIfNeeded();
						}
					}
				}
			}
		}

		return result;
	}

	private void function _resetState() {
		structClear( variables._entries );
	}

	private string function _buildKey(
		required string template,
		required string openDelimiter,
		required string closeDelimiter
	) {
		// Length-prefix each component so arbitrary delimiter/template content remains
		// an exact, collision-free composite key without hashing or copying prefixes.
		return len( arguments.openDelimiter ) & ":" & arguments.openDelimiter
			& len( arguments.closeDelimiter ) & ":" & arguments.closeDelimiter
			& len( arguments.template ) & ":" & arguments.template;
	}

	private void function _touchKey( required any cacheKey, required any value ) {
		structDelete( variables._entries, arguments.cacheKey );
		variables._entries[ arguments.cacheKey ] = arguments.value;
	}

	private void function _evictIfNeeded() {
		var excess = structCount( variables._entries ) - variables._cacheMaxEntries;
		if ( excess <= 0 ) {
			return;
		}

		var keys = structKeyArray( variables._entries );
		for ( var i = 1; i <= excess; i++ ) {
			structDelete( variables._entries, keys[ i ] );
		}
	}

}
