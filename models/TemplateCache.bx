import java.util.List;
import java.util.LinkedHashMap;

/**
 * Thread-safe, in-memory LRU cache for parsed template ASTs.
 *
 * An access-ordered Java map stores exact source/delimiter tuples and recency.
 * BoxLang locks protect reads and writes, including hits that update recency.
 * Tuple keys retain source strings instead of copying them. The cache remains
 * instance-local so isolated renderers do not share lifecycle or eviction state.
 */
@accessors( false )
class implements="ITemplateCache" {
	property name="cacheMaxEntries" type="numeric" default=200;
	property name="cacheEnabled" type="boolean" default=true;
	property name="cacheGeneration" type="numeric" default=0;

	final variables.entries = new LinkedHashMap( 16, 0.75, true );
	final variables.cacheLockName = "Mustache.TemplateCache.#replace( createUUID(), "-", "", "all" )#";

	public void function configure(
		boolean enabled = true,
		numeric maxEntries = 200
	) {
		bx:lock name=variables.cacheLockName type="exclusive" timeout="5" {
			variables.cacheEnabled = arguments.enabled;
			variables.cacheMaxEntries = max( 1, int( arguments.maxEntries ) );
			variables.cacheGeneration++;

			if ( !variables.cacheEnabled ) {
				resetState();
			} else {
				evictIfNeeded();
			}
		}
	}

	public void function clear() {
		bx:lock name=variables.cacheLockName type="exclusive" timeout="5" {
			variables.cacheGeneration++;
			resetState();
		}
	}

	public struct function getStats() {
		var stats = {};
		bx:lock name=variables.cacheLockName type="readonly" timeout="5" {
			stats = {
				enabled: variables.cacheEnabled,
				maxEntries: variables.cacheMaxEntries,
				currentEntries: variables.entries.size()
			};
		}
		return stats;
	}

	public array function getOrSet(
		required string template,
		required string openDelimiter,
		required string closeDelimiter,
		required function parseFn
	) {
		var cacheKey = [];
		var cachedAst = [];
		var hasCached = false;
		var cacheEnabled = false;

		// A hit is moved to the tail, so this must be exclusive.
		bx:lock name=variables.cacheLockName type="exclusive" timeout="5" {
			cacheEnabled = variables.cacheEnabled;
			if ( cacheEnabled ) {
				cacheKey = buildKey( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
				if ( variables.entries.containsKey( cacheKey ) ) {
					hasCached = true;
					cachedAst = variables.entries.get( cacheKey );
				}
			}
		}

		if ( !cacheEnabled ) {
			return arguments.parseFn( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
		}

		if ( hasCached ) {
			return cachedAst;
		}

		// Coalesce only identical misses. Different templates retain parallelism.
		var keyLockName = "#variables.cacheLockName#.key.#cacheKey.hashCode()#";
		var result = [];
		var hasResult = false;

		bx:lock name=keyLockName type="exclusive" timeout="5" {
			var currentGeneration = 0;
			var currentEnabled = false;

			bx:lock name=variables.cacheLockName type="exclusive" timeout="5" {
				currentEnabled = variables.cacheEnabled;
				currentGeneration = variables.cacheGeneration;
				if ( currentEnabled && variables.entries.containsKey( cacheKey ) ) {
					result = variables.entries.get( cacheKey );
					hasResult = true;
				}
			}

			if ( !hasResult ) {
				if ( !currentEnabled ) {
					result = arguments.parseFn( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
					hasResult = true;
				} else {
					var ast = arguments.parseFn( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
					result = ast;
					hasResult = true;

					bx:lock name=variables.cacheLockName type="exclusive" timeout="5" {
						if (
							variables.cacheEnabled &&
							variables.cacheGeneration == currentGeneration
						) {
							if ( !variables.entries.containsKey( cacheKey ) ) {
								variables.entries.put( cacheKey, ast );
							}
							evictIfNeeded();
						}
					}
				}
			}
		}

		return result;
	}

	private void function resetState() {
		variables.entries.clear();
	}

	private any function buildKey(
		required string template,
		required string openDelimiter,
		required string closeDelimiter
	) {
		// List equality compares all three strings case-sensitively, including on
		// hash collisions. Reused Java strings also reuse their computed hashes.
		return List::of( arguments.template, arguments.openDelimiter, arguments.closeDelimiter );
	}

	private void function evictIfNeeded() {
		var excess = variables.entries.size() - variables.cacheMaxEntries;
		if ( excess <= 0 ) {
			return;
		}

		for ( var i = 1; i <= excess; i++ ) {
			variables.entries.pollFirstEntry();
		}
	}

}
