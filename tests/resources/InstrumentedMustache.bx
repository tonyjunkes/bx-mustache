import bxModules.bxMustache.models.Mustache;
import tests.resources.InstrumentedParser;

class extends="Mustache" {
	variables.instrumentedParser = new InstrumentedParser();

	public function init() {
		super.init( parser = variables.instrumentedParser );
		return this;
	}

	public numeric function getParseCallCount() {
		return variables.instrumentedParser.getParseCallCount();
	}
}
