import bxModules.bxMustache.models.Mustache;
import tests.resources.GeneratedAccessorFixture;
import tests.resources.InheritedAccessorFixture;

class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Native object access", () => {
			it( "renders public fields, generated getters, and inherited accessors", () => {
				var renderer = new Mustache();
				var person = new InheritedAccessorFixture();
				person.setName( "Grace" );
				expect( renderer.render( "{{person.name}}|{{person.label}}|{{person.active}}|{{person.role}}", { person: person } ) )
					.toBeWithCase( "Grace|public field|true|Engineer" );
			} );

			it( "keeps private state and runtime implementation members out of lookup", () => {
				var renderer = new Mustache();
				var person = new GeneratedAccessorFixture();
				for ( var name in [ "token", "hidden", "secret", "getSecret", "variablesScope.token", "getVariablesScope", "class", "$bx" ] ) {
					expect( renderer.render( "[{{person.#name#}}]", { person: person } ) ).toBeWithCase( "[]" );
				}
				expect( person.calls ).toBe( 0 );
			} );

			it( "does not call getters requiring arguments or missing-method handlers", () => {
				var person = new GeneratedAccessorFixture();
				expect( new Mustache().render( "{{person.required}}|{{person.absent}}", { person: person } ) )
					.toBeWithCase( "|" );
				expect( person.calls ).toBe( 0 );
			} );

			it( "propagates errors from public getters", () => {
				var person = new GeneratedAccessorFixture();
				expect( () => new Mustache().render( "{{person.broken}}", { person: person } ) )
					.toThrow( type = "Mustache.MockError", message = "Getter failed" );
			} );
		} );
	}
}
