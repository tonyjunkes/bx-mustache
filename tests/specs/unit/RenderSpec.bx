import bxModules.bxMustache.models.Mustache as MustacheRenderer;
import tests.resources.DynamicLookupFixture as DynamicLookupFixtureClass;

/**
 * mustache render() BDD Test
 */
class extends="testbox.system.BaseSpec" {
	function run( testResults, testBox ){
		describe( "mustache render()", function(){
			beforeEach( function(){
				variables.mustache = new MustacheRenderer();
			} );

			it( "keeps collaborators and render internals private without generated accessors", function(){
				var renderer = variables.mustache;
				for ( var name in [ "tokenizer", "parser", "cache", "compileTemplates", "contextResolver" ] ) {
					expect( structKeyExists( renderer, name ) ).toBeFalse();
					expect( structKeyExists( renderer, "get" & name ) ).toBeFalse();
					expect( structKeyExists( renderer, "set" & name ) ).toBeFalse();
				}
				expect( renderer.render(
					"{{engine.tokenizer}}|{{engine.parser}}|{{engine.cache}}|{{engine.compileTemplates}}|{{engine.renderNodes}}",
					{ engine: renderer }
				) ).toBeWithCase( "||||" );
			} );

			it( "keeps nested, reentrant, and consecutive render output independent", function(){
				var renderer = variables.mustache;
				var source = "before{{##rows}}[{{name}}:{{##values}}{{.}}{{/values}}{{^values}}empty{{/values}}]{{/rows}}/{{lambda}}after";
				var first = renderer.render( source, {
					rows: [ { name: "A", values: [ "x", "y" ] }, { name: "B", values: [] } ],
					lambda: () => renderer.render( "nested" )
				} );
				var second = renderer.render( source, {
					rows: [ { name: "C", values: [ "z" ] } ],
					lambda: () => "other"
				} );
				expect( first ).toBeWithCase( "before[A:xy][B:empty]/nestedafter" );
				expect( second ).toBeWithCase( "before[C:z]/otherafter" );
			} );

			it( "escapes variables and preserves unescaped output", function(){
				var output = variables.mustache.render(
					"{{html}}|{{{html}}}|{{& html}}",
					{ html: "<b>x</b>" }
				);

				expect( output ).toBeWithCase( "&lt;b&gt;x&lt;&##x2f;b&gt;|<b>x</b>|<b>x</b>" );
			} );

			it( "escapes ampersands, angle brackets, quotes, and apostrophes", function(){
				var raw = '&<>"' & char( 39 );
				var output = variables.mustache.render(
					"{{html}}",
					{ html: raw }
				);

				expect( output ).toBeWithCase( "&amp;&lt;&gt;&quot;&##x27;" );
			} );

			it( "renders dotted paths and numeric array indexes", function(){
				var output = variables.mustache.render(
					"{{user.name}}|{{users.2.name}}",
					{
						user: { name: "Ada" },
						users: [
							{ name: "Grace" },
							{ name: "Linus" }
						]
					}
				);

				expect( output ).toBeWithCase( "Ada|Linus" );
			} );

			it( "does not invoke arbitrary Java methods during lookup", function(){
				var buffer = new java.lang.StringBuilder( "abc" );
				expect( variables.mustache.render( "{{buffer.reverse}}", { buffer: buffer } ) ).toBeWithCase( "" );
				expect( buffer.toString() ).toBeWithCase( "abc" );
			} );

			it( "treats null intermediate paths and null array items as missing", function(){
				expect( variables.mustache.render(
					"{{user.profile.name}}|{{##items}}[{{name}}:{{.}}]{{/items}}",
					{ user: { profile: null }, items: [ null ], name: "parent" }
				) ).toBeWithCase( "|[parent:]" );
			} );

			it( "accepts tabs between changed delimiters", function(){
				expect( variables.mustache.render( "{{=<%#char( 9 )#%>=}}<%name%>", { name: "Ada" } ) ).toBeWithCase( "Ada" );
			} );

			it( "dedents inherited blocks with tabs without stripping text beginning with t", function(){
				for ( var newline in [ char( 10 ), char( 13 ) & char( 10 ) ] ) {
					for ( var indentation in [ char( 9 ), "  ", "" ] ) {
						expect( variables.mustache.render(
							"{{<layout}}{{$body}}#newline##indentation#text#newline#{{/body}}{{/layout}}",
							{}, { layout: "{{$body}}default{{/body}}" }
						) ).toBeWithCase( "text#newline#" );
					}
				}
			} );

			it( "resolves values from native objects via dynamic path lookup", function(){
				var person = new DynamicLookupFixtureClass()
					.init( "Ada", "Architect" );
				var output = variables.mustache.render(
					"{{person.name}}|{{person.role}}|{{person.missing}}",
					{ person: person }
				);

				expect( output ).toBeWithCase( "Ada|Architect|" );
			} );

			it( "rethrows object accessor errors instead of treating them as missing values", function(){
				var mockObject = {
					getCoolThing: () => {
						throw( type = "Mustache.MockError", message = "Mock Error!" );
					}
				};

				expect( function(){
					variables.mustache.render(
						"{{action.getCoolThing}}",
						{ action: mockObject }
					);
				} ).toThrow( type = "Mustache.MockError", message = "Mock Error!" );
			} );

			it( "falls back to parent context when a key is missing in the current item", function(){
				var output = variables.mustache.render(
					"{{##people}}{{name}}-{{title}};{{/people}}",
					{
						title: "Team",
						people: [
							{ name: "Ada" },
							{ name: "Linus" }
						]
					}
				);

				expect( output ).toBeWithCase( "Ada-Team;Linus-Team;" );
			} );

			it( "uses current context with dot lookups inside array sections", function(){
				var output = variables.mustache.render(
					"{{##items}}({{.}}){{/items}}",
					{ items: [ "a", "b", "c" ] }
				);

				expect( output ).toBeWithCase( "(a)(b)(c)" );
			} );

			it( "renders sections for struct contexts", function(){
				var output = variables.mustache.render(
					"{{##person}}{{name}}:{{role}}{{/person}}",
					{ person: { name: "Ada", role: "Engineer" } }
				);

				expect( output ).toBeWithCase( "Ada:Engineer" );
			} );

			it( "honors falsey values and inverted sections", function(){
				var output = variables.mustache.render(
					"{{##count}}C{{/count}}|{{##empty}}E{{/empty}}|{{^count}}NC{{/count}}|{{^empty}}NE{{/empty}}",
					{ count: 0, empty: "" }
				);

				expect( output ).toBeWithCase( "||NC|NE" );
			} );

			it( "handles empty arrays for sections and inverted sections", function(){
				var output = variables.mustache.render(
					"{{##items}}X{{/items}}|{{^items}}Y{{/items}}",
					{ items: [] }
				);

				expect( output ).toBeWithCase( "|Y" );
			} );

			it( "ignores comments and missing partials during rendering", function(){
				var output = variables.mustache.render(
					"A{{! comment }}{{> missing}}B",
					{},
					{}
				);

				expect( output ).toBeWithCase( "AB" );
			} );

			it( "renders partials from string and closure values", function(){
				var fromString = variables.mustache.render(
					"User: {{> row}}",
					{ name: "Ada" },
					{ row: "{{name}}" }
				);

				var fromClosure = variables.mustache.render(
					"User: {{> row}}",
					{ name: "Linus" },
					{
						row: function(){
							return "{{name}}";
						}
					}
				);

				expect( fromString ).toBeWithCase( "User: Ada" );
				expect( fromClosure ).toBeWithCase( "User: Linus" );
			} );

			it( "supports variable lambdas with arity 0 and 1", function(){
				var output = variables.mustache.render(
					"{{calc}}|{{greet}}|{{templateValue}}",
					{
						name: "mustache",
						calc: function(){
							return 2 + 2;
						},
						greet: function( context ){
							return "Hi " & arguments.context.name;
						},
						templateValue: function(){
							return "{{name}}";
						}
					}
				);

				expect( output ).toBeWithCase( "4|Hi mustache|mustache" );
			} );

			it( "supports section lambdas with arity 0, 1, and 2", function(){
				var output = variables.mustache.render(
					"{{##zero}}x{{/zero}}|{{##one}}Hi {{name}}{{/one}}|{{##two}}Hi {{name}}{{/two}}",
					{
						name: "Ada",
						zero: function(){
							return "{{name}}";
						},
						one: function( text ){
							return "<" & arguments.text & ">";
						},
						two: function( text, renderer ){
							return "[" & arguments.renderer( arguments.text ) & "]";
						}
					}
				);

				expect( output ).toBeWithCase( "Ada|<Hi Ada>|[Hi Ada]" );
			} );

			it( "renders lambda results containing only the current alternate delimiter", function(){
				expect( variables.mustache.render(
					"{{= | | =}}<|##lambda|-|/lambda|>", {
						planet: "Earth",
						lambda: ( text ) => text & "|planet|" & text
					}
				) ).toBeWithCase( "<-Earth->" );
			} );

			it( "uses native falsey string coercion consistently for both section kinds", function(){
				for ( var value in [ "false", "no", "0", "", false, 0, null, [] ] ) {
					expect( variables.mustache.render( "{{##value}}yes{{/value}}{{^value}}no{{/value}}", { value: value } ) )
						.toBeWithCase( "no" );
				}
			} );

			it( "returns empty output for missing variables and sections", function(){
				var output = variables.mustache.render(
					"A{{missing}}B{{##unknown}}X{{/unknown}}C",
					{}
				);

				expect( output ).toBeWithCase( "ABC" );
			} );
		} );
	}
}
