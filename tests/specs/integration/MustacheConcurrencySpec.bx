import bxModules.bxMustache.models.Mustache as MustacheRenderer;

/**
 * Mustache integration concurrency test
 */
class extends="testbox.system.BaseSpec" {
	function run( testResults, testBox ){
		describe( "Mustache integration", function(){
			beforeEach( function(){
				variables.mustache = new MustacheRenderer();
			} );

			it( "handles concurrent renders on a shared instance and respects cache limits", function(){
				var threadNames  = [];
				var totalThreads = 20;
				var iterations   = 5;
				var maxEntries   = 7;

				variables.mustache.clearCache();
				variables.mustache.configureCache( enabled = true, maxEntries = maxEntries );

				for ( var i = 1; i <= totalThreads; i++ ) {
					var threadName = "mustacheRender_" & i & "_" & getTickCount();
					arrayAppend( threadNames, threadName );

					thread
						action      = "run"
						name        = threadName
						mustache     = variables.mustache
						threadIndex = i
						iterations  = iterations
					{
						thread.hadError = false;
						thread.completed = false;
						thread.result   = "";

						try {
							for ( var j = 1; j <= attributes.iterations; j++ ) {
								var template = "T" & attributes.threadIndex & "-" & j & ":{{name}}-{{##arr}}{{.}}{{/arr}}";
								thread.result = attributes.mustache.render(
									template,
									{
										name : "N" & attributes.threadIndex,
										arr  : [ 1, 2, 3 ]
									}
								);
							}
						} catch ( any e ) {
							thread.hadError     = true;
							thread.errorMessage = e.message;
						} finally {
							thread.completed = true;
						}
					};
				}

				thread action = "join" name = arrayToList( threadNames ) timeout = 10000;

				for ( var i = 1; i <= arrayLen( threadNames ); i++ ) {
					var thisThreadName = threadNames[ i ];
					var expected       = "T" & i & "-" & iterations & ":N" & i & "-123";

					expect( structKeyExists( bxThread, thisThreadName ) ).toBeTrue();
					expect( structKeyExists( bxThread[ thisThreadName ], "completed" ) && bxThread[ thisThreadName ].completed )
						.toBeTrue( "Thread did not complete: #thisThreadName#" );
					expect( bxThread[ thisThreadName ].hadError )
						.toBeFalse( structKeyExists( bxThread[ thisThreadName ], "errorMessage" ) ? bxThread[ thisThreadName ].errorMessage : "" );
					expect( bxThread[ thisThreadName ].result ).toBe( expected );
				}

				var stats = variables.mustache.getCacheStats();
				expect( stats.enabled ).toBeTrue();
				expect( stats.maxEntries ).toBe( maxEntries );
				expect( stats.currentEntries ).toBeLTE( maxEntries );
			} );

			it( "remains stable when cache is toggled during concurrent renders", function(){
				var renderThreadNames  = [];
				var toggleThreadNames  = [];
				var renderThreads      = 12;
				var renderIterations   = 12;
				var toggleThreads      = 3;
				var toggleIterations   = 20;

				variables.mustache.clearCache();
				variables.mustache.configureCache( enabled = true, maxEntries = 6 );

				for ( var i = 1; i <= renderThreads; i++ ) {
					var renderThreadName = "mustacheRenderToggle_" & i & "_" & getTickCount();
					arrayAppend( renderThreadNames, renderThreadName );

					thread
						action          = "run"
						name            = renderThreadName
						mustache         = variables.mustache
						threadIndex     = i
						iterations      = renderIterations
					{
						thread.hadError = false;
						thread.completed = false;
						thread.result   = "";

						try {
							for ( var j = 1; j <= attributes.iterations; j++ ) {
								thread.result = attributes.mustache.render(
									"{{##items}}{{name}}:{{.}};{{/items}}",
									{
										name  : "N" & attributes.threadIndex,
										items : [ 1, 2, 3 ]
									}
								);
							}
						} catch ( any e ) {
							thread.hadError     = true;
							thread.errorMessage = e.message;
						} finally {
							thread.completed = true;
						}
					};
				}

				for ( var i = 1; i <= toggleThreads; i++ ) {
					var toggleThreadName = "mustacheCacheToggle_" & i & "_" & getTickCount();
					arrayAppend( toggleThreadNames, toggleThreadName );

					thread
						action        = "run"
						name          = toggleThreadName
						mustache       = variables.mustache
						iterations    = toggleIterations
						threadOrdinal = i
					{
						thread.hadError = false;
						thread.completed = false;
						thread.result   = "";

						try {
							for ( var j = 1; j <= attributes.iterations; j++ ) {
								var enabled = ( j % 2 == 0 );
								var cap     = ( ( j + attributes.threadOrdinal ) % 5 ) + 1;
								attributes.mustache.configureCache( enabled = enabled, maxEntries = cap );
								thread.result = "ok";
							}
						} catch ( any e ) {
							thread.hadError     = true;
							thread.errorMessage = e.message;
						} finally {
							thread.completed = true;
						}
					};
				}

				thread action = "join" name = arrayToList( renderThreadNames ) timeout = 10000;
				thread action = "join" name = arrayToList( toggleThreadNames ) timeout = 10000;

				for ( var i = 1; i <= arrayLen( renderThreadNames ); i++ ) {
					var thisRenderThreadName = renderThreadNames[ i ];
					var expected             = "N" & i & ":1;N" & i & ":2;N" & i & ":3;";

					expect( structKeyExists( bxThread, thisRenderThreadName ) ).toBeTrue();
					expect( structKeyExists( bxThread[ thisRenderThreadName ], "completed" ) && bxThread[ thisRenderThreadName ].completed )
						.toBeTrue( "Thread did not complete: #thisRenderThreadName#" );
					expect( bxThread[ thisRenderThreadName ].hadError )
						.toBeFalse( structKeyExists( bxThread[ thisRenderThreadName ], "errorMessage" ) ? bxThread[ thisRenderThreadName ].errorMessage : "" );
					expect( bxThread[ thisRenderThreadName ].result ).toBe( expected );
				}

				for ( var i = 1; i <= arrayLen( toggleThreadNames ); i++ ) {
					var thisToggleThreadName = toggleThreadNames[ i ];

					expect( structKeyExists( bxThread, thisToggleThreadName ) ).toBeTrue();
					expect( structKeyExists( bxThread[ thisToggleThreadName ], "completed" ) && bxThread[ thisToggleThreadName ].completed )
						.toBeTrue( "Thread did not complete: #thisToggleThreadName#" );
					expect( bxThread[ thisToggleThreadName ].hadError )
						.toBeFalse( structKeyExists( bxThread[ thisToggleThreadName ], "errorMessage" ) ? bxThread[ thisToggleThreadName ].errorMessage : "" );
					expect( bxThread[ thisToggleThreadName ].result ).toBe( "ok" );
				}

				variables.mustache.configureCache( enabled = true, maxEntries = 4 );

				var stats = variables.mustache.getCacheStats();
				expect( stats.enabled ).toBeTrue();
				expect( stats.maxEntries ).toBe( 4 );
				expect( stats.currentEntries ).toBeLTE( stats.maxEntries );
			} );
		} );
	}
}
