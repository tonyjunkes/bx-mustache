import bxModules.bxMustache.models.Mustache as MustacheRenderer;
import tests.resources.InstrumentedMustache as InstrumentedMustacheFixture;
import tests.resources.MockTemplateCache as MockTemplateCacheFixture;

/**
 * Mustache cache integration BDD Test
 */
class extends="testbox.system.BaseSpec" {
	function run( testResults, testBox ){
		describe( "Mustache cache controls integration", function(){
			beforeEach( function(){
				variables.mustache = new MustacheRenderer();
			} );

			it( "reports default cache stats", function(){
				var stats = variables.mustache.getCacheStats();

				expect( stats ).toHaveKey( "enabled" );
				expect( stats ).toHaveKey( "maxEntries" );
				expect( stats ).toHaveKey( "currentEntries" );
				expect( stats.enabled ).toBeTrue();
				expect( stats.maxEntries ).toBe( 200 );
				expect( stats.currentEntries ).toBe( 0 );
			} );

			it( "enforces a minimum cache size of 1", function(){
				variables.mustache.configureCache( enabled = true, maxEntries = 0 );
				var stats = variables.mustache.getCacheStats();

				expect( stats.maxEntries ).toBe( 1 );
			} );

			it( "caches parsed templates by template text", function(){
				variables.mustache.render( "Hello {{name}}", { name: "Ada" } );
				var firstStats = variables.mustache.getCacheStats();

				variables.mustache.render( "Hello {{name}}", { name: "Linus" } );
				var secondStats = variables.mustache.getCacheStats();

				expect( firstStats.currentEntries ).toBe( 1 );
				expect( secondStats.currentEntries ).toBe( 1 );
			} );

			it( "retains recently reused templates when evicting entries", function(){
				var instrumentedmustache = new InstrumentedMustacheFixture();
				instrumentedmustache.clearCache();
				instrumentedmustache.configureCache( enabled = true, maxEntries = 2 );

				instrumentedmustache.render( "One {{name}}", { name: "Ada" } );
				instrumentedmustache.render( "Two {{name}}", { name: "Ada" } );
				instrumentedmustache.render( "One {{name}}", { name: "Ada" } );
				instrumentedmustache.render( "Three {{name}}", { name: "Ada" } );

				expect( instrumentedmustache.getParseCallCount() ).toBe( 3 );

				instrumentedmustache.render( "One {{name}}", { name: "Ada" } );
				instrumentedmustache.render( "Two {{name}}", { name: "Ada" } );

				expect( instrumentedmustache.getParseCallCount() ).toBe( 4 );
			} );

			it( "can disable cache and avoid storing parsed templates", function(){
				variables.mustache.render( "A {{name}}", { name: "Ada" } );
				variables.mustache.configureCache( enabled = false );

				var disabledStats = variables.mustache.getCacheStats();
				expect( disabledStats.enabled ).toBeFalse();
				expect( disabledStats.currentEntries ).toBe( 0 );

				variables.mustache.render( "B {{name}}", { name: "Ada" } );
				var afterRenderStats = variables.mustache.getCacheStats();
				expect( afterRenderStats.currentEntries ).toBe( 0 );
			} );

			it( "evicts least recently used templates when max entries is exceeded", function(){
				variables.mustache.configureCache( enabled = true, maxEntries = 1 );

				variables.mustache.render( "One {{name}}", { name: "Ada" } );
				variables.mustache.render( "Two {{name}}", { name: "Ada" } );
				var stats = variables.mustache.getCacheStats();

				expect( stats.maxEntries ).toBe( 1 );
				expect( stats.currentEntries ).toBe( 1 );
			} );

			it( "clears cache entries manually", function(){
				variables.mustache.render( "Hello {{name}}", { name: "Ada" } );
				variables.mustache.clearCache();

				var stats = variables.mustache.getCacheStats();
				expect( stats.currentEntries ).toBe( 0 );
			} );

			it( "accepts a custom ITemplateCache implementation via init()", function(){
				var mockCache = new MockTemplateCacheFixture();
				var mustache = new MustacheRenderer().init( cache = mockCache );

				mustache.render( "Hello {{name}}", { name: "Ada" } );
				mustache.render( "Hello {{name}}", { name: "Linus" } );

				expect( mockCache.getCallCount() ).toBe( 2 );
			} );
		} );
	}
}
